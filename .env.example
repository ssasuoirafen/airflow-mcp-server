# Copy to .env (gitignored) or set these in your MCP client's env block.

# Required: Airflow base URL (no /api/... suffix)
AIRFLOW_MCP_BASE_URL=http://localhost:8080

# Auth: either basic auth ...
AIRFLOW_MCP_USERNAME=airflow
AIRFLOW_MCP_PASSWORD=airflow
# ... or a bearer token (takes precedence over username/password)
#AIRFLOW_MCP_API_TOKEN=

# Optional
#AIRFLOW_MCP_READ_ONLY=false        # true disables every write tool
#AIRFLOW_MCP_VERIFY_SSL=true
#AIRFLOW_MCP_TIMEOUT=30
